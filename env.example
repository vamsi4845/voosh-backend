PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
JINA_API_KEY=your_jina_api_key_here

# Qdrant Cloud (recommended - free tier available)
# Sign up at https://cloud.qdrant.io/ and get your cluster URL and API key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Or for local development:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY= (not needed for local)

# Upstash Redis (recommended - free tier: 10K commands/day)
# Sign up at https://upstash.com/ and get your Redis URL
REDIS_URL=redis://default:password@your-endpoint.upstash.io:6379

# Or for local development:
# REDIS_URL=redis://localhost:6379

SESSION_TTL=86400
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

